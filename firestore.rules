rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with Firebase
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sovereign Master Super Admin Email Whitelist
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "moraasdorcah@gmail.com" ||
        request.auth.token.email == "urbaninteriorkenya@gmail.com" ||
        request.auth.token.email == "naisiaetext@gmail.com"
      );
    }

    // Hospital Staff & Employees Directory
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }
    match /staff/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    // Hospital Patients & EHR Medical Records
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // System Tickets (Intake, Encounters, Services)
    match /system_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Encounters (Parent-Subcollection Architecture)
    match /encounters/{encounterId} {
      allow read, write: if true;
      
      // Encounter Dynamic Forms & Line Items Subcollections
      match /vitals/{vitalId} {
        allow read, write: if true;
      }
      match /prescriptions/{rxId} {
        allow read, write: if true;
      }
      match /lab_requests/{labId} {
        allow read, write: if true;
      }
      match /bill_items/{billId} {
        allow read, write: if true;
      }
      match /nursing_notes/{noteId} {
        allow read, write: if true;
      }
    }

    // Hospital Inpatient Wards & Beds Management
    match /hospital_wards/{wardId} {
      allow read, write: if true;
    }
    match /hospital_beds/{bedId} {
      allow read, write: if true;
    }

    // Live Queue & Routing Tokens
    match /queue/{queueId} {
      allow read, write: if true;
    }

    // Hospital Billing & Invoices
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Pharmacy Stock & Inventory
    match /medications/{medicationId} {
      allow read, write: if true;
    }

    // Staff Payroll
    match /payroll/{payrollId} {
      allow read, write: if true;
    }

    // Security Gate Logs
    match /security_logs/{logId} {
      allow read, write: if true;
    }

    // Procurement & Requisitions
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /purchase_orders/{poId} {
      allow read, write: if true;
    }
    match /purchase_requisitions/{reqId} {
      allow read, write: if true;
    }
    match /goods_received/{grnId} {
      allow read, write: if true;
    }

    // System Settings & Facility Branding
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
    match /branding/{brandId} {
      allow read, write: if true;
    }
    
    // Catch-all fallback for extensions & custom collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
