rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with Firebase
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sovereign Master Super Admin Email Whitelist
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "tassiahillhospital@gmail.com" ||
        request.auth.token.email == "moraasdorcah@gmail.com" ||
        request.auth.token.email == "urbaninteriorkenya@gmail.com" ||
        request.auth.token.email == "zamodasports@gmail.com" ||
        request.auth.token.email == "veronicanjus@gmail.com" ||
        request.auth.token.email == "admin@tassiahill.co.ke" ||
        request.auth.token.email == "director@tassiahill.co.ke" ||
        request.auth.token.email == "superadmin@tassiahill.co.ke"
      );
    }

    // Hospital Staff & Employees Directory
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /system_users/{userId} {
      allow read, write: if true;
    }

    // Hospital Patients & EHR Medical Records
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // System Tickets (Intake, Encounters, Services)
    match /system_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Encounters (Parent-Subcollection Architecture)
    match /encounters/{encounterId} {
      allow read, write: if true;
      
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    match /clinical_encounters/{encounterId} {
      allow read, write: if true;
      
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Direct Lab Requests & Results Root Collections
    match /lab_requests/{labId} {
      allow read, write: if true;
    }
    match /lab_results/{resultId} {
      allow read, write: if true;
    }
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
    match /chat_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /transfers/{transferId} {
      allow read, write: if true;
    }

    // Hospital Inpatient Wards & Beds Management
    match /hospital_wards/{wardId} {
      allow read, write: if true;
    }
    match /hospital_beds/{bedId} {
      allow read, write: if true;
    }
    match /wards/{wardId} {
      allow read, write: if true;
    }
    match /beds/{bedId} {
      allow read, write: if true;
    }
    match /ward_bed_rates/{rateId} {
      allow read, write: if true;
    }

    // Live Queue & Routing Tokens
    match /queue/{queueId} {
      allow read, write: if true;
    }
    match /queue_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /patient_transfers/{transferId} {
      allow read, write: if true;
    }
    match /patient_carts/{cartId} {
      allow read, write: if true;
    }

    // Hospital Billing, Invoices & Claims
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /cashier_shifts/{shiftId} {
      allow read, write: if true;
    }
    match /debtor_claims/{claimId} {
      allow read, write: if true;
    }
    match /remittance_batches/{batchId} {
      allow read, write: if true;
    }
    match /payment_vouchers/{voucherId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /general_ledger/{entryId} {
      allow read, write: if true;
    }
    match /procedure_tariffs/{tariffId} {
      allow read, write: if true;
    }

    // Pharmacy Stock & Inventory
    match /medications/{medicationId} {
      allow read, write: if true;
    }

    // Staff Payroll
    match /payroll/{payrollId} {
      allow read, write: if true;
    }

    // Security Gate Logs & Watchlists
    match /security_logs/{logId} {
      allow read, write: if true;
    }
    match /security_watchlists/{watchId} {
      allow read, write: if true;
    }

    // Internal Communication
    match /internal_messages/{messageId} {
      allow read, write: if true;
    }

    // Procurement, Suppliers & Requisitions
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /purchase_orders/{poId} {
      allow read, write: if true;
    }
    match /purchase_requisitions/{reqId} {
      allow read, write: if true;
    }
    match /goods_received/{grnId} {
      allow read, write: if true;
    }
    match /procurement_suppliers/{sId} {
      allow read, write: if true;
    }
    match /procurement_orders/{oId} {
      allow read, write: if true;
    }
    match /procurement_requisitions/{rId} {
      allow read, write: if true;
    }
    match /procurement_grns/{gId} {
      allow read, write: if true;
    }
    match /supplier_invoices/{invId} {
      allow read, write: if true;
    }

    // System Settings, Audit Logs & Facility Branding
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }
    match /settings_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /policy_acknowledgments/{ackId} {
      allow read, write: if true;
    }
    match /branding/{brandId} {
      allow read, write: if true;
    }
    
    // Native Web Push Subscriptions
    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Public Health & Disease Surveillance (eIDSR, MOH 505, IHR 2005)
    match /surveillance_cases/{caseId} {
      allow read, write: if true;
    }
    match /idsr_reports/{reportId} {
      allow read, write: if true;
    }
    match /public_health_events/{eventId} {
      allow read, write: if true;
    }
    match /ihr_notifications/{ihrId} {
      allow read, write: if true;
    }
    
    // Default secure catch-all: Only Sovereign Super Admin can access unknown collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
